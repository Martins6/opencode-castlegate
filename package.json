{
  "name": "opencode-castlegate",
  "version": "0.1.1",
  "description": "OpenCode plugin that auto-approves tool calls when they match the user's session intent, validated by a lightweight model.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --test-reporter=spec test/store.test.ts test/validate.test.ts test/intent.test.ts test/config.test.ts test/errors.test.ts test/prompt-body.test.ts"
  },
  "keywords": [
    "opencode",
    "plugin",
    "agent",
    "guardrail",
    "intent",
    "auto-approve"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Martins6/opencode-castlegate.git"
  },
  "bugs": {
    "url": "https://github.com/Martins6/opencode-castlegate/issues"
  },
  "homepage": "https://github.com/Martins6/opencode-castlegate#readme",
  "files": [
    "src",
    "README.md",
    "SPEC.md",
    "docs",
    "LICENSE"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
